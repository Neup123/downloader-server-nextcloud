{
  "name": "nextcloud-downloader-ui-bridge",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Nextcloud standard UI hooks only",
  "scripts": {
    "build": "esbuild src/bridge.ts --bundle --minify --format=iife --platform=browser --target=es2022 --outfile=js/bridge.js && esbuild src/dashboard.ts --bundle --minify --format=iife --platform=browser --target=es2022 --outfile=js/dashboard.js",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@nextcloud/files": "4.1.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}

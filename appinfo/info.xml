<?xml version="1.0" encoding="UTF-8"?>
<info>
    <id>downloader-server-nextcloud</id>
    <name>Downloader Server</name>
    <summary>Per-user download jobs delivered to your Nextcloud Files</summary>
    <description>Nextcloud AppAPI gateway to the separately deployed Downloader Server. It does not run downloads inside Nextcloud.</description>
    <version>0.5.3</version>
    <licence>BUSL-1.1</licence>
    <author>Neup123</author>
    <namespace>DownloaderServer</namespace>
    <category>tools</category>
    <website>https://github.com/Neup123/downloader-server-nextcloud</website>
    <repository type="git">https://github.com/Neup123/downloader-server-nextcloud</repository>
    <dependencies>
        <nextcloud min-version="35" max-version="35"/>
    </dependencies>
    <external-app>
        <docker-install>
            <registry>ghcr.io</registry>
            <image>neup123/downloader-server-nextcloud</image>
            <image-tag>0.5.3</image-tag>
        </docker-install>
        <environment-variables>
            <variable>
                <name>DOWNLOADER_API_URL</name>
                <display-name>Downloader Server URL</display-name>
                <description>HTTPS origin of your separate Downloader Server API</description>
            </variable>
            <variable>
                <name>DOWNLOADER_API_TOKEN</name>
                <display-name>Downloader Server API token</display-name>
                <description>Service token kept inside the ExApp server, never exposed to browsers</description>
            </variable>
            <variable>
                <name>DOWNLOADER_WEBDAV_ORIGIN</name>
                <display-name>Nextcloud public HTTPS Files origin</display-name>
                <description>Optional public HTTPS origin of this Nextcloud instance. Use when AppAPI NEXTCLOUD_URL is a private HTTP address and the guarded downloader must reach WebDAV through the public HTTPS endpoint.</description>
                <default></default>
            </variable>
            <variable>
                <name>DOWNLOADER_ALLOW_TRUSTED_HTTP</name>
                <display-name>Allow private-network HTTP</display-name>
                <description>Set to true only for an isolated, administrator-controlled Docker network</description>
                <default>false</default>
            </variable>
        </environment-variables>
        <routes>
            <route><url>^/$</url><verb>GET</verb><access_level>ADMIN</access_level></route>
            <route><url>^/assets/.*$</url><verb>GET</verb><access_level>USER</access_level></route>
            <route><url>^/api-reference$</url><verb>GET</verb><access_level>ADMIN</access_level></route>
            <route><url>^/api/v1/.*$</url><verb>GET</verb><access_level>ADMIN</access_level></route>
            <route><url>^/api/v1/.*$</url><verb>POST</verb><access_level>ADMIN</access_level></route>
            <route><url>^/api/v1/.*$</url><verb>PUT</verb><access_level>ADMIN</access_level></route>
            <route><url>^/api/v1/.*$</url><verb>PATCH</verb><access_level>ADMIN</access_level></route>
            <route><url>^/api/v1/.*$</url><verb>DELETE</verb><access_level>ADMIN</access_level></route>
            <route><url>^/user/$</url><verb>GET</verb><access_level>USER</access_level></route>
            <route><url>^/user/api/.*$</url><verb>GET</verb><access_level>USER</access_level></route>
            <route><url>^/user/api/.*$</url><verb>POST</verb><access_level>USER</access_level></route>
            <route><url>^/user/api/.*$</url><verb>PUT</verb><access_level>USER</access_level></route>
            <route><url>^/user/api/.*$</url><verb>DELETE</verb><access_level>USER</access_level></route>
            <route><url>^/admin/api/.*$</url><verb>GET</verb><access_level>ADMIN</access_level></route>
            <route><url>^/admin/api/.*$</url><verb>PUT</verb><access_level>ADMIN</access_level></route>
        </routes>
    </external-app>
</info>

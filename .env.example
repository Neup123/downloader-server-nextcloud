# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_API_TOKEN=replace-with-a-random-secret

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required only when storing WebDAV app passwords. Keep the same key across restarts and backups.
APP_ENCRYPTION_KEY=

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_YTDLP=1
MAX_CONCURRENT_ARIA2=1
MAX_CONCURRENT_GALLERY_DL=1
MAX_CONCURRENT_GENERIC=1
MAX_CONCURRENT_YOU_GET=1
MAX_CONCURRENT_SVTPLAY_DL=1
MAX_CONCURRENT_GET_SAUCE=1
ALLOW_PRIVATE_TARGETS=false
# Delivery has its own trust policy. Keep both false for public HTTPS WebDAV.
# Enable only for a private, controlled Nextcloud/Docker network.
ALLOW_PRIVATE_WEBDAV_TARGETS=false
# Plain HTTP exposes app-password material to anyone on the network path.
ALLOW_INSECURE_WEBDAV=false

# Maximum time a downloader engine may run before its job fails (60–604800s).
JOB_TIMEOUT_SECONDS=86400
